<Page
    x:Class="PartFinder.Views.Pages.MasterDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PartFinder.Views.Components"
    xmlns:converters="using:PartFinder.Converters">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <Style x:Key="ToolbarSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="ToolbarConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarSegmentButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="20" Background="Transparent" Transitions="{StaticResource LuxuryPanelTransitions}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                HorizontalAlignment="Left"
                Padding="10,8"
                Background="{StaticResource ElevatedCardBackgroundBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="{Binding ShowTemplatePicker, Converter={StaticResource BoolToVisibilityConverter}}">
                <ComboBox
                    MinWidth="260"
                    HorizontalAlignment="Left"
                    FontSize="12"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DataTemplates}"
                    PlaceholderText="Choose template…"
                    SelectedItem="{Binding SelectedDataTemplate, Mode=TwoWay}" />
            </Border>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="{Binding IsEditMode, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <Button
                    Style="{StaticResource ToolbarSegmentButtonStyle}"
                    Foreground="{StaticResource AccentPrimaryBrush}"
                    IsEnabled="{Binding CanEditMasterData}"
                    Click="OnToggleEditModeClicked"
                    ToolTipService.ToolTip="Edit master data">
                    <SymbolIcon Symbol="Edit" />
                </Button>

                <Button
                    Style="{StaticResource ToolbarSegmentButtonStyle}"
                    Click="OnExportTemplateClicked"
                    ToolTipService.ToolTip="Export Excel">
                    <SymbolIcon Symbol="Upload" />
                </Button>

                <Button
                    Style="{StaticResource ToolbarSegmentButtonStyle}"
                    Click="OnImportExcelClicked"
                    IsEnabled="{Binding CanAddMasterData}"
                    ToolTipService.ToolTip="Import Excel">
                    <SymbolIcon Symbol="Download" />
                </Button>
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button
                    Style="{StaticResource ToolbarConfirmButtonStyle}"
                    Click="OnSaveGridClicked"
                    ToolTipService.ToolTip="Save changes">
                    <SymbolIcon Symbol="Accept" />
                </Button>

                <Button
                    Style="{StaticResource ToolbarSegmentButtonStyle}"
                    Click="OnCancelEditClicked"
                    ToolTipService.ToolTip="Cancel editing">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,6" Spacing="6">
            <!-- Status messages -->
            <StackPanel Spacing="4">
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    Text="Loading..."
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{Binding StatusMessage}"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    Text="Choose a template from the header. Edit, export and import from the right."
                    Visibility="{Binding IsEditMode, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    Text="Edit mode enabled. Use the top-right tick to save or the cancel button to discard."
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    Text="Create and save a Master Data template under Templates to see columns here."
                    TextWrapping="Wrap"
                    Visibility="{Binding ShowNoTemplateHint, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    Text="No tenant database is configured. Complete setup with a valid organization and database connection."
                    TextWrapping="Wrap"
                    Visibility="{Binding ShowNoDatabaseHint, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>

        <!-- Spreadsheet + optional detail column (no modal overlay) -->
        <Grid
            Grid.Row="2"
            Margin="0,4,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ActionResultsColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource ElevatedCardBackgroundBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="0">
                    <ContentControl
                        x:Name="SpreadsheetHost"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                </Border>
                <Button
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="16,8"
                    Command="{Binding AddRowCommand}"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="Add row" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                x:Name="ActionResultsPanel"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="14"
                Visibility="Collapsed"
                CornerRadius="16"
                Background="{StaticResource ElevatedCardBackgroundBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="ActionTitleText"
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="âœ•"
                    FontSize="12"
                    Click="OnCloseActionPanelClick" />

                <TextBlock
                    x:Name="ActionCountText"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,4,0,10"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondaryBrush}" />

                <ListView x:Name="ActionRowsListView" Grid.Row="2">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,6"
                                Padding="10"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Translation="0,0,32">
                            <Border.Shadow><ThemeShadow/></Border.Shadow>
                            <StackPanel Spacing="3">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords" />
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>



