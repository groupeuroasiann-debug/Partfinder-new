<UserControl
    x:Class="PartFinder.Views.Components.InviteUserControl"
    x:Name="InviteUserRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:viewModels="using:PartFinder.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />

        <Style x:Key="InviteFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CharacterSpacing" Value="60" />
        </Style>

        <Style x:Key="InviteDialogGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600">
        <StackPanel Spacing="14" Padding="0,0,12,0">

            <!-- Email + Full Name side by side -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource InviteFieldLabelStyle}" />
                    <TextBox
                        PlaceholderText="name@company.com"
                        FontSize="13"
                        Padding="10,8"
                        IsReadOnly="{Binding IsEditMode}"
                        Text="{Binding InviteEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="FULL NAME" Style="{StaticResource InviteFieldLabelStyle}" />
                    <TextBox
                        PlaceholderText="John Doe"
                        FontSize="13"
                        Padding="10,8"
                        Text="{Binding InviteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <!-- Role selector -->
            <StackPanel Spacing="4">
                <TextBlock Text="ROLE" Style="{StaticResource InviteFieldLabelStyle}" />
                <ComboBox
                    ItemsSource="{Binding RoleOptions}"
                    PlaceholderText="Select role"
                    FontSize="13"
                    Padding="10,8"
                    HorizontalAlignment="Stretch"
                    SelectedItem="{Binding InviteRole, Mode=TwoWay}" />
            </StackPanel>

            <!-- Admin: full access (no template picker required) -->
            <Border Background="#151F7AE0" CornerRadius="6" Padding="10" BorderBrush="#301F7AE0" BorderThickness="1"
                    Visibility="{Binding IsAdminRole, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Top" />
                    <TextBlock
                        Text="This admin will automatically receive full permissions and access to all templates across the organization."
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <!-- Employee role summary -->
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsEmployeeRole, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Top" />
                    <TextBlock
                        Text="Employees use scoped permissions. Choose template access and master data rights below."
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <!-- Granular Permissions (Employee only) -->
            <StackPanel Visibility="{Binding IsEmployeeRole, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="10">

                <!-- Template Permissions -->
                <StackPanel Spacing="4">
                    <TextBlock Text="TEMPLATE PERMISSIONS" Style="{StaticResource InviteFieldLabelStyle}" />
                    <Grid ColumnSpacing="0" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Add" IsChecked="{Binding InviteCanAddTemplate, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                        <CheckBox Grid.Column="1" Content="View" IsChecked="{Binding InviteCanViewTemplate, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                        <CheckBox Grid.Column="2" Content="Edit" IsChecked="{Binding InviteCanEditTemplate, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                        <CheckBox Grid.Column="3" Content="Delete" IsChecked="{Binding InviteCanDeleteTemplate, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                    </Grid>
                </StackPanel>

                <!-- Master Data Permissions -->
                <StackPanel Spacing="4">
                    <TextBlock Text="MASTER DATA PERMISSIONS" Style="{StaticResource InviteFieldLabelStyle}" />
                    <Grid ColumnSpacing="0" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" Content="View" IsChecked="{Binding InviteCanViewMasterData, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="Edit" IsChecked="{Binding InviteCanEditMasterData, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                        <CheckBox Grid.Row="0" Grid.Column="2" Content="Add" IsChecked="{Binding InviteCanAddMasterData, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="Delete" IsChecked="{Binding InviteCanDeleteMasterData, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Copy" IsChecked="{Binding InviteCanCopyMasterData, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Template access (Employee only) -->
            <StackPanel Visibility="{Binding IsEmployeeRole, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="8">
                <Border Background="{StaticResource ElevatedCardBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <CheckBox Content="Grant access to all templates" IsChecked="{Binding InvitePartsAllTemplates, Mode=TwoWay}" FontSize="12" />
                        <TextBlock
                            Foreground="{StaticResource TextTertiaryBrush}"
                            FontSize="10"
                            Text="Uncheck to pick specific templates from the list below."
                            TextWrapping="WrapWholeWords" />

                        <!-- Selected templates (chips) -->
                        <TextBlock Text="SELECTED TEMPLATES" Style="{StaticResource InviteFieldLabelStyle}" Margin="0,4,0,0" />
                        <Border MinHeight="36" Padding="8" CornerRadius="6"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding SelectedTemplateAccessItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:TemplatePickItemViewModel">
                                        <Border CornerRadius="12" Padding="8,4"
                                                Background="#151F7AE0"
                                                BorderBrush="#301F7AE0" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" FontSize="11"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Button Content="×" FontSize="10" Padding="4,0" MinWidth="0" MinHeight="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveTemplateAccessCommand, ElementName=InviteUserRoot}"
                                                        CommandParameter="{x:Bind}"
                                                        IsEnabled="{Binding DataContext.CanPickSpecificTemplates, ElementName=InviteUserRoot}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="No templates selected yet." FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Visibility="{Binding HasSelectedTemplateAccess, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Select All" FontSize="11" Style="{StaticResource InviteDialogGhostButtonStyle}"
                                    Command="{Binding SelectAllTemplatesCommand}" />
                            <Button Content="Clear All" FontSize="11" Style="{StaticResource InviteDialogGhostButtonStyle}"
                                    Command="{Binding ClearTemplateSelectionCommand}" />
                        </StackPanel>

                        <TextBlock Text="ADD TEMPLATE ACCESS" Style="{StaticResource InviteFieldLabelStyle}" />
                        <ComboBox
                            PlaceholderText="Choose a template…"
                            FontSize="12"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding TemplateChoices}"
                            SelectedItem="{Binding TemplatePickerHighlight, Mode=TwoWay}"
                            IsEnabled="{Binding CanPickSpecificTemplates}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
