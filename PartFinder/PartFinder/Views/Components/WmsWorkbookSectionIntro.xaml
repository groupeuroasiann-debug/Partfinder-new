<UserControl
    x:Class="PartFinder.Views.Components.WmsWorkbookSectionIntro"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6" Margin="0,0,0,16">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource WmsSectionTitleStyle}" />
        <TextBlock
            Text="{x:Bind Description, Mode=OneWay}"
            Style="{StaticResource WmsFormHintStyle}"
            Margin="0" />
    </StackPanel>
</UserControl>