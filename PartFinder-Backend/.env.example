# Copy this file to `.env` in the same folder (PartFinder-Backend/.env).
# `.env` is gitignored — never commit real secrets.

# --- Required ---
MONGODB_URI=mongodb://127.0.0.1:27017/partfinder
JWT_SECRET=replace-with-a-long-random-string

# --- Server ---
PORT=3000
# Comma-separated browser origins for CORS (optional in local dev)
CORS_ORIGIN=http://127.0.0.1:5173

# --- Self-serve licence checkout (Razorpay Test Mode, $10 USD) ---
# Get Test Mode keys: https://dashboard.razorpay.com/app/keys
# Use Key ID (public, starts with rzp_test_) and Key Secret (private) from the same Test Mode pair.
# Enable USD / international payments on your Razorpay account if order creation fails on currency.
LICENSE_PURCHASE_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# --- Optional: Redis, Elasticsearch, invite email — see existing platform setup ---
